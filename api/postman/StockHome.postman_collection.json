{
  "info": {
    "name": "StockHome API",
    "description": "REST API for StockHome (home pantry stock control).\n\nQuick start:\n1. Start the API (`npm run dev`) and make sure the DB is seeded (`npm run db:seed`).\n2. Run **Auth > Login** (demo user: marina.alves@email.com / 123456). The token is saved automatically into the `token` collection variable and used by every other request.\n3. Run the other requests. Product requests use the `productId` variable (default 1); some requests update it automatically.\n\nUser-facing strings (error messages, status labels) are in pt-BR by design.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
        "description": "Healthcheck. Does not require auth."
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('token saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Pedro Silva\",\n  \"email\": \"joao@teste.com\",\n  \"password\": \"senha123\",\n  \"alertDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Create an account. Returns { token, user }. The token is saved to the `token` variable."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('has token', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.token);",
                  "console.log('token saved for', json.user && json.user.email);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"marina.alves@email.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Log in with the demo user. Saves the token to the `token` variable used by every authenticated request."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] },
            "description": "Logged-in user data."
          },
          "response": []
        },
        {
          "name": "Update me",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marina Alves\",\n  \"alertDays\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/me", "host": ["{{baseUrl}}"], "path": ["api", "me"] },
            "description": "Update name and/or alertDays (the expiry alert window)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "description": "List categories (alimentos, bebidas, limpeza, higiene)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=&category=&status=&sort=name",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "", "description": "Search by name (case-insensitive)" },
                { "key": "category", "value": "", "description": "alimentos | bebidas | limpeza | higiene" },
                { "key": "status", "value": "", "description": "ok | low | expiring | expired" },
                { "key": "sort", "value": "name", "description": "name | expiresAt | lastUpdated | quantity" }
              ]
            },
            "description": "List the user's products. All query params are optional — leave blank to disable a filter."
          },
          "response": []
        },
        {
          "name": "List products - expiring",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?status=expiring&sort=expiresAt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "status", "value": "expiring" },
                { "key": "sort", "value": "expiresAt" }
              ]
            },
            "description": "Example filter: items expiring within the alert window, sorted by expiry date."
          },
          "response": []
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Product detail. Uses the `productId` variable."
          },
          "response": []
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('productId', String(json.id));",
                  "  console.log('productId set to', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manteiga 200g\",\n  \"categoryId\": \"alimentos\",\n  \"quantity\": 1,\n  \"minQuantity\": 2,\n  \"unit\": \"potes\",\n  \"expiresAt\": \"2026-06-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Create a product. `expiresAt` accepts \"YYYY-MM-DD\" or null. The new id is saved to the `productId` variable so the following requests target it."
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manteiga com sal 200g\",\n  \"quantity\": 3,\n  \"expiresAt\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Edit product fields. Send only the fields you want to change. `expiresAt: null` clears the expiry date."
          },
          "response": []
        },
        {
          "name": "Adjust quantity (stepper +1)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/quantity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}", "quantity"]
            },
            "description": "Adjust quantity like the app steppers. Use { \"delta\": 1 } / { \"delta\": -1 } (never below 0) or { \"quantity\": 5 } for an absolute value."
          },
          "response": []
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Delete the product referenced by `productId`. Returns 204."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "summary"]
            },
            "description": "Home screen: total, counters and low/expiring lists."
          },
          "response": []
        },
        {
          "name": "Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alerts"]
            },
            "description": "Alerts screen: items needing attention (expired, low, expiring), grouped by type."
          },
          "response": []
        }
      ]
    }
  ]
}
